<template>
  <header>
    <h1 k-on:click="changeTitle">{{ title }}</h1>
  </header>
</template>

<script>
import { bus } from '../main';

export default {
  props: {
    title: {
      type: String
    }
  },
  data() {
    return {
      title: 'Kdu Ninjas'
    }
  },
  methods: {
    changeTitle: function () {
      // this.$emit('changeTitle', 'Kdu Wizards');
      this.title = 'Kdu Wizards';
      bus.$emit('titleChanged', 'Kdu Wizards');
    }
  }
}
</script>

<style scoped>
header {
  background: lightblue;
  padding: 10px;
}

h1 {
  color: #222;
  text-align: center;
}
</style>
